# ─────────────────────────────────────────────────────────────
# Phober — corner-stone env file
#
# Everything else lives in docker-compose.*.yml.
# Copy to .env and fill in real values for your machine.
# ─────────────────────────────────────────────────────────────

# ── App ──
APP_ENV=local
APP_DEBUG=true
APP_TIMEZONE=Asia/Baku
LOG_LEVEL=debug
TELESCOPE_ENABLED=true

# ── Laravel APP_KEY per service (generate with `php artisan key:generate --show`) ──
APP_KEY_ADMINPANEL=base64:10GvWo3QVZLvODVr0rKxufpyI2rUVmLqbWv6dfEWs4U=
APP_KEY_AUTH_SERVER=base64:10GvWo3QVZLvODVr0rKxufpyI2rUVmLqbWv6dfEWs4U=
APP_KEY_CONFIG_SERVER=base64:10GvWo3QVZLvODVr0rKxufpyI2rUVmLqbWv6dfEWs4U=
APP_KEY_CRM_SERVICE=base64:10GvWo3QVZLvODVr0rKxufpyI2rUVmLqbWv6dfEWs4U=
APP_KEY_DEVICE_SERVICE=base64:10GvWo3QVZLvODVr0rKxufpyI2rUVmLqbWv6dfEWs4U=
APP_KEY_NOTIFICATION_SERVER=base64:10GvWo3QVZLvODVr0rKxufpyI2rUVmLqbWv6dfEWs4U=
APP_KEY_STAFF_SERVICE=base64:10GvWo3QVZLvODVr0rKxufpyI2rUVmLqbWv6dfEWs4U=
APP_KEY_DB_MIGRATION=base64:10GvWo3QVZLvODVr0rKxufpyI2rUVmLqbWv6dfEWs4U=

# ── Inter-service auth secret (X-Service-Secret header, PrivateMiddleware). Same value on every service.
# Rotate independently of APP_KEY_*: generate with `openssl rand -hex 32` ──
SERVICE_SECRET=changeme-generate-with-openssl-rand-hex-32

# ── desktop-overlay → device-service auth (X-Overlay-Secret header, OverlaySecretMiddleware).
# Narrower than SERVICE_SECRET: only grants GET /hardware/schedule/{macAddress}. Rotate the same way. ──
OVERLAY_SECRET=changeme-generate-with-openssl-rand-hex-32

# ── MySQL ──
MYSQL_ROOT_PASSWORD=root
MYSQL_PUBLIC_PORT=8306

# ── Redis ──
REDIS_PUBLIC_PORT=8379

# ── Reverb (WebSocket broadcast) ──
REVERB_APP_ID=phober
REVERB_APP_KEY=phober-key
REVERB_APP_SECRET=phober-secret

# ── S3 / MinIO ──
AWS_ACCESS_KEY_ID=defaultaccesskey
AWS_SECRET_ACCESS_KEY=defaultsecretkey
MINIO_WEB_UI_PORT=9100

# ── API gateway ──
API_GATEWAY_HOST=https://api.phober.test
API_GATEWAY_PORT=8000

# ── Notification channels (optional) ──
DISCORD_TOKEN=
DISCORD_SUPPORT_CHANNEL=
DISCORD_OTP_CHANNEL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_OTP_CHANNEL=
TELEGRAM_SUPPORT_CHANNEL=

# ── ELK ──
ELASTIC_PASSWORD=Password1*
KIBANA_PORT=8601
